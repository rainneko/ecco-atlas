# Postgres + pgvector, built to run under OpenShift's arbitrary UID.
# You only need this for Phase 2 (embedding similarity). Phase 1 runs on the
# stock openshift/postgresql image.
#
#   oc new-build --name ecco-db-pgvector --binary --strategy=docker
#   oc start-build ecco-db-pgvector --from-dir=deploy/postgres-pgvector --follow
# then point the ecco-db Deployment at the resulting imagestream.
FROM quay.io/sclorg/postgresql-16-c9s:latest

USER 0
RUN dnf install -y --setopt=tsflags=nodocs postgresql-server-devel gcc make git \
    && git clone --depth 1 --branch v0.8.0 https://github.com/pgvector/pgvector.git /tmp/pgvector \
    && make -C /tmp/pgvector && make -C /tmp/pgvector install \
    && rm -rf /tmp/pgvector \
    && dnf remove -y gcc make git && dnf clean all
USER 26
